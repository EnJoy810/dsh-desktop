import Cocoa
import WebKit

private let dshPort = 3080
private let dshURL = URL(string: "http://127.0.0.1:\(dshPort)")!

final class AppDelegate: NSObject, NSApplicationDelegate {
    private var window: NSWindow!
    private var webView: WKWebView!
    private var serverProcess: Process?

    func applicationDidFinishLaunching(_ notification: Notification) {
        NSApp.setActivationPolicy(.regular)
        setupMenu()
        setupWindow()
        NSApp.activate(ignoringOtherApps: true)
        startServerIfNeeded()
    }

    private func setupMenu() {
        let mainMenu = NSMenu()

        let appMenuItem = NSMenuItem()
        mainMenu.addItem(appMenuItem)
        let appMenu = NSMenu()
        appMenu.addItem(withTitle: "Quit DeepSeek", action: #selector(NSApplication.terminate(_:)), keyEquivalent: "q")
        appMenuItem.submenu = appMenu

        let editMenuItem = NSMenuItem()
        mainMenu.addItem(editMenuItem)
        let editMenu = NSMenu(title: "Edit")
        editMenu.addItem(withTitle: "Copy", action: #selector(NSText.copy(_:)), keyEquivalent: "c")
        editMenu.addItem(withTitle: "Paste", action: #selector(NSText.paste(_:)), keyEquivalent: "v")
        editMenu.addItem(withTitle: "Select All", action: #selector(NSText.selectAll(_:)), keyEquivalent: "a")
        editMenuItem.submenu = editMenu

        let viewMenuItem = NSMenuItem()
        mainMenu.addItem(viewMenuItem)
        let viewMenu = NSMenu(title: "View")
        viewMenu.addItem(withTitle: "Reload", action: #selector(reloadPage(_:)), keyEquivalent: "r")
        viewMenu.addItem(withTitle: "Toggle Developer Tools", action: #selector(toggleDevTools(_:)), keyEquivalent: "d")
        viewMenuItem.submenu = viewMenu

        let windowMenuItem = NSMenuItem()
        mainMenu.addItem(windowMenuItem)
        let windowMenu = NSMenu(title: "Window")
        windowMenu.addItem(withTitle: "Minimize", action: #selector(NSWindow.miniaturize(_:)), keyEquivalent: "m")
        windowMenu.addItem(withTitle: "Close", action: #selector(NSWindow.performClose(_:)), keyEquivalent: "w")
        windowMenuItem.submenu = windowMenu

        NSApp.mainMenu = mainMenu
        NSApp.windowsMenu = windowMenu
    }

    private func setupWindow() {
        let contentRect = NSRect(x: 0, y: 0, width: 1280, height: 860)
        window = NSWindow(contentRect: contentRect,
                          styleMask: [.titled, .closable, .miniaturizable, .resizable],
                          backing: .buffered, defer: false)
        window.title = "DeepSeek"
        window.isOpaque = true
        window.backgroundColor = .white
        window.center()

        let config = WKWebViewConfiguration()
        config.websiteDataStore = .default()
        let css = "\nvar css = `\nhtml, body {\n  background: url(\"data:image/jpeg;base64,\") center / contain no-repeat fixed !important;\n}\nbody { --dsw-alias-bg-base: transparent !important; }\n#root { background: transparent !important; }\n#root [class$=\"_frame\"], #root [class$=\"_root\"] { background: transparent !important; background-color: transparent !important; }\n#root [class$=\"_sidebarCol\"] {\n  background: rgba(255, 255, 255, 0.16) !important;\n  background-color: rgba(255, 255, 255, 0.16) !important;\n  backdrop-filter: blur(28px) saturate(170%) !important;\n  -webkit-backdrop-filter: blur(28px) saturate(170%) !important;\n}\n#root [class*=\"hHd-Xa_\"] { background: transparent !important; background-color: transparent !important; }\n#root [class$=\"_centerCol\"], #root [class$=\"_detailsCol\"] {\n  background: rgba(255, 255, 255, 0.6) !important;\n  background-color: rgba(255, 255, 255, 0.6) !important;\n  backdrop-filter: blur(28px) saturate(170%) !important;\n  -webkit-backdrop-filter: blur(28px) saturate(170%) !important;\n}\n`;\nvar style = document.createElement('style');\nstyle.textContent = css;\ndocument.documentElement.appendChild(style);\n"
        let script = WKUserScript(source: css, injectionTime: .atDocumentEnd, forMainFrameOnly: true)
        config.userContentController.addUserScript(script)
        webView = WKWebView(frame: contentRect, configuration: config)
        webView.autoresizingMask = [.width, .height]
        window.contentView = webView
        window.makeKeyAndOrderFront(nil)
    }

    private func startServerIfNeeded() {
        // First check whether a dsh web instance is already serving our port.
        checkPort() { [weak self] reachable in
            if reachable {
                self?.loadWebUI()
            } else {
                self?.spawnServer()
            }
        }
    }

    private func checkPort(done: @escaping (Bool) -> Void) {
        var request = URLRequest(url: dshURL)
        request.timeoutInterval = 3
        URLSession.shared.dataTask(with: request) { _, response, _ in
            let ok = (response as? HTTPURLResponse).map { (200...299).contains($0.statusCode) } ?? false
            DispatchQueue.main.async { done(ok) }
        }.resume()
    }

    /// Resolve the node binary. GUI apps do not inherit a shell PATH, so we
    /// look inside the user's nvm installs first, then fall back to PATH.
    private func resolveNode() -> String {
        let nvmBase = NSString(string: "~").expandingTildeInPath + "/.nvm/versions/node"
        let fm = FileManager.default
        if let versions = try? fm.contentsOfDirectory(atPath: nvmBase) {
            let sorted = versions.sorted(by: >)
            for v in sorted {
                let candidate = nvmBase + "/" + v + "/bin/node"
                if fm.isExecutableFile(atPath: candidate) { return candidate }
            }
        }
        return "/usr/bin/env node"
    }

    /// Prefer the already-downloaded dsh bundle inside the npx cache (it may
    /// carry local patches). Fall back to npx only if nothing is cached.
    private func resolveDshBin() -> String? {
        let cacheBase = NSString(string: "~").expandingTildeInPath + "/.npm/_npx"
        let fm = FileManager.default
        guard let entries = try? fm.contentsOfDirectory(atPath: cacheBase) else { return nil }
        var candidates: [String] = []
        for entry in entries {
            let dir = cacheBase + "/" + entry + "/node_modules/@deepseek-ai/dsh"
            if fm.fileExists(atPath: dir + "/lib/bin.js") { candidates.append(dir) }
        }
        return candidates.sorted(by: >).first.map { $0 + "/lib/bin.js" }
    }

    private func spawnServer() {
        let node = resolveNode()
        let dshBin = resolveDshBin()
        let process = Process()
        process.executableURL = URL(fileURLWithPath: node)

        var args: [String]
        if let bin = dshBin {
            args = [bin, "web", "--port", String(dshPort)]
        } else {
            let npx = (node as NSString).deletingLastPathComponent + "/npx"
            process.executableURL = URL(fileURLWithPath: npx)
            args = ["-y", "@deepseek-ai/dsh", "web", "--port", String(dshPort)]
        }
        process.arguments = args

        let pipe = Pipe()
        process.standardOutput = pipe
        process.standardError = pipe
        pipe.fileHandleForReading.readabilityHandler = { handle in
            let data = handle.availableData
            if let line = String(data: data, encoding: .utf8), !line.isEmpty {
                NSLog("[dsh] %@", line.trimmingCharacters(in: .whitespacesAndNewlines))
            }
        }

        do {
            try process.run()
            serverProcess = process
        } catch {
            NSLog("[dsh] failed to spawn server: %@", error.localizedDescription)
            loadWebUI() // let the web view show its own connection error
            return
        }

        // Poll until the port accepts requests, then load the UI.
        pollReady(retries: 60) { [weak self] in self?.loadWebUI() }
    }

    private func pollReady(retries: Int, done: @escaping () -> Void) {
        checkPort { [weak self] ok in
            if ok { done(); return }
            if retries <= 0 {
                NSLog("[dsh] server did not become ready in time")
                done()
                return
            }
            DispatchQueue.main.asyncAfter(deadline: .now() + 1.0) {
                self?.pollReady(retries: retries - 1, done: done)
            }
        }
    }

    private func loadWebUI() {
        webView.load(URLRequest(url: dshURL))
    }

    @objc private func reloadPage(_ sender: Any?) {
        webView.reload()
    }

    @objc private func toggleDevTools(_ sender: Any?) {
        // macOS WKWebView has no inspect API; open the page in the default
        // browser instead, where devtools are available.
        NSWorkspace.shared.open(dshURL)
    }

    func applicationShouldTerminateAfterLastWindowClosed(_ sender: NSApplication) -> Bool {
        return true
    }

    func applicationWillTerminate(_ notification: Notification) {
        if let p = serverProcess, p.isRunning {
            p.terminate()
            DispatchQueue.global().asyncAfter(deadline: .now() + 2) {
                if p.isRunning { p.interrupt() }
            }
        }
    }
}

let app = NSApplication.shared
let delegate = AppDelegate()
app.delegate = delegate
app.run()
